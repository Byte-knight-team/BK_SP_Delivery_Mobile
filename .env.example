# Backend API Base URL
#
# For Android Emulator (accesses host machine localhost):
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
#
# For iOS Simulator (accesses host machine localhost):
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
#
# For physical device (must be on same WiFi network as backend):
#   EXPO_PUBLIC_API_BASE_URL=http://<your-machine-ip>:8080
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Google Directions API key (for route fetching in DeliveryMapView)
# IMPORTANT: This key is used in plain HTTP fetch() calls from the device.
# It must have NO application restrictions (or "None" restriction) in Google Cloud Console.
# Do NOT use the same key as app.json's android.config.googleMaps.apiKey if that key
# has Android app (SHA-1) restrictions, as those restrictions block HTTP requests.
EXPO_PUBLIC_DIRECTIONS_API_KEY=your_unrestricted_directions_api_key_here
